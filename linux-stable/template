# place your kernel configuration at files/dotconfig
pkg_name=linux-stable
version=7.2.9
revision=1
build_style=custom
short_desc="The Linux kernel"
home_page="https://kernel.org"
license="GPL-2.0-only"
dist_files="https://cdn.kernel.org/pub/linux/kernel/v7.x/linux-${version}.tar.xz"
checksum="904c40caf312b66bcfdf626d6063699260227b1fd7d2a4edddded5757828a79c"
wrk_src="linux-$version"

# bison and flex build kconfig, libelf builds objtool, libressl signs modules
# and builds the trusted keyring, perl is used by several scripts for whatever fuckin reason
make_depends="bison flex libelf libressl perl gtar"

use_flags="modules"

# vmlinuz is a compressed image and modules carry relocations, stripping
# either of them produces something that does not boot or does not load
no_strip=yes

do_configure() {
    [ -f "$FILESDIR/dotconfig" ] || die "no kernel config at files/dotconfig"
    cp -f "$FILESDIR/dotconfig" .config

    # accept defaults for anything the config predates without prompting
    $make_cmd olddefconfig
}

do_build() {
    $make_cmd $make_jobs
    if use modules; then
        $make_cmd $make_jobs modules
    fi
}

do_install() {
    # the module directory is named after the full release, which includes
    # CONFIG_LOCALVERSION, so check rather than assuming $version
    _rel=$($make_cmd -s kernelrelease)

    binstall arch/x86/boot/bzImage 0644 /boot "vmlinuz-$_rel"
    binstall System.map 0644 /boot "System.map-$_rel"
    binstall .config 0644 /boot "config-$_rel"

    if use modules; then
        $make_cmd INSTALL_MOD_PATH="$DESTDIR/usr" INSTALL_MOD_STRIP=1 modules_install
        # These point into the build tree, which will not exist.
        rm -f "$DESTDIR/usr/lib/modules/$_rel/build" \
              "$DESTDIR/usr/lib/modules/$_rel/source"
    fi
}
